# Windows 批处理必须保持 CRLF，否则 cmd 解析出错
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 其余文本统一 LF，避免 "LF will be replaced by CRLF" 刷屏
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.scss  text eol=lf
*.toml  text eol=lf

# 二进制资源不做换行符转换
*.mp3   binary
*.m4a   binary
*.flac  binary
*.wav   binary
*.ogg   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.zip   binary
*.gz    binary
*.pdf   binary
